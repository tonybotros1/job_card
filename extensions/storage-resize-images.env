# Firebase "Resize Images" extension - parameters for the job-card-62478 project.
# Produces car_pictures/thumbnails/<name>_600x600.jpg for every photo in car_pictures
# (existing ones via backfill, new ones on upload). The apps look for exactly that path.
IMG_BUCKET=job-card-62478.appspot.com
IMG_SIZES=600x600
DELETE_ORIGINAL_FILE=false
MAKE_PUBLIC=false
RESIZED_IMAGES_PATH=thumbnails
INCLUDE_PATH_LIST=/car_pictures
EXCLUDE_PATH_LIST=/car_pictures/thumbnails
FAILED_IMAGES_PATH=
CACHE_CONTROL_HEADER=public,max-age=259200
IMAGE_TYPE=false
OUTPUT_OPTIONS=
SHARP_OPTIONS=
IS_ANIMATED=true
FUNCTION_MEMORY=1024
REGENERATE_TOKEN=true
CONTENT_FILTER_LEVEL=OFF
CUSTOM_FILTER_PROMPT=
PLACEHOLDER_IMAGE_PATH=
DO_BACKFILL=true
LOCATION=us-central1
